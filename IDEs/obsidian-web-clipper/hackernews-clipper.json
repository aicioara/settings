{
	"schemaVersion": "0.1.0",
	"name": "HackerNews",
	"behavior": "create",
	"noteContentFormat": "{{selection}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "short",
			"value": "",
			"type": "text"
		},
		{
			"name": "discussion",
			"value": "",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\", \\\"|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "image",
			"value": "{{image}}",
			"type": "text"
		},
		{
			"name": "favicon",
			"value": "{{favicon}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "clippings, hackernews",
			"type": "multitext"
		},
		{
			"name": "categories",
			"value": "web",
			"type": "multitext"
		},
		{
			"name": "status",
			"value": "TODO",
			"type": "text"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{date|date:\"YYYY-MM-DD\"}} - {{title|safe_name|replace:\"/[\\\"'.,&\\(\\)+’]/g\":\"\"|replace:(\"—\":\"-\", \"–\":\"-\")|title}}",
	"path": "Clippings"
}